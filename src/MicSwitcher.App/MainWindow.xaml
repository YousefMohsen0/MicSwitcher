<Window x:Class="MicSwitcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MicSwitcher.App"
        Title="MicSwitcher" Width="580" Height="820" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterScreen">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20">

      <!-- Status -->
      <Border Padding="14" CornerRadius="8" Background="#F3F6FA" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock x:Name="ActiveText" FontSize="20" FontWeight="SemiBold" Text="Starting…"/>
          <TextBlock x:Name="DetailText" Foreground="#555555" TextWrapping="Wrap" Margin="0,4,0,10"/>
          <CheckBox x:Name="PauseCheck" Content="Pause automatic switching"
                    Checked="PauseCheck_Changed" Unchecked="PauseCheck_Changed"/>
        </StackPanel>
      </Border>

      <!-- Microphones -->
      <GroupBox Header="Microphones" Padding="10" Margin="0,0,0,14">
        <StackPanel>
          <local:MicRow x:Name="ProRow"/>
          <local:MicRow x:Name="HeadsetRow"/>
          <local:MicRow x:Name="LaptopRow"/>
        </StackPanel>
      </GroupBox>

      <!-- Calibration and tuning -->
      <GroupBox Header="Pro mic calibration" Padding="10" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock TextWrapping="Wrap" Foreground="#555555"
                     Text="Measures your room noise, then your normal speaking level, to set the voice threshold. It can also adjust the Windows input volume of the pro mic so your voice lands at a good level."/>
          <CheckBox x:Name="AdjustGainCheck" Margin="0,10,0,0"
                    Content="Also adjust the Windows input volume (gain)"
                    Checked="AdjustGainCheck_Changed" Unchecked="AdjustGainCheck_Changed"/>
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="CalibrateButton" Content="Calibrate pro mic…" Padding="14,5" Click="CalibrateButton_Click"/>
            <TextBlock x:Name="CalibrationText" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="320"/>
          </StackPanel>

          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="210"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="64"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Voice threshold" VerticalAlignment="Center"/>
            <Slider x:Name="ThresholdSlider" Grid.Column="1" Minimum="-80" Maximum="-10" Margin="0,6"
                    ValueChanged="ThresholdSlider_ValueChanged"/>
            <TextBlock x:Name="ThresholdValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="1" Text="Switch to headset after silence" VerticalAlignment="Center"/>
            <Slider x:Name="SilenceSlider" Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="30" Margin="0,6"
                    ValueChanged="SilenceSlider_ValueChanged"/>
            <TextBlock x:Name="SilenceValue" Grid.Row="1" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="2" Text="Switch back after voice for" VerticalAlignment="Center"/>
            <Slider x:Name="ReturnSlider" Grid.Row="2" Grid.Column="1" Minimum="100" Maximum="1500" Margin="0,6"
                    ValueChanged="ReturnSlider_ValueChanged"/>
            <TextBlock x:Name="ReturnValue" Grid.Row="2" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
        </StackPanel>
      </GroupBox>

      <!-- Behaviour -->
      <GroupBox Header="Behaviour" Padding="10" Margin="0,0,0,14">
        <StackPanel>
          <CheckBox x:Name="CommsCheck" Margin="0,0,0,8"
                    Content="Also change the default communications device (Teams, Discord, Zoom…)"
                    Checked="CommsCheck_Changed" Unchecked="CommsCheck_Changed"/>
          <CheckBox x:Name="StartupCheck"
                    Content="Start with Windows (runs in the background with administrator rights)"
                    Checked="StartupCheck_Changed" Unchecked="StartupCheck_Changed"/>
          <TextBlock Margin="22,4,0,0" Foreground="#666666" TextWrapping="Wrap"
                     Text="Turning this on or off asks for administrator permission once. Closing this window keeps MicSwitcher running in the system tray; use the tray menu to exit."/>
        </StackPanel>
      </GroupBox>

      <!-- Log -->
      <GroupBox Header="Activity log" Padding="10">
        <ListBox x:Name="LogList" Height="150" FontFamily="Consolas" FontSize="12"/>
      </GroupBox>

    </StackPanel>
  </ScrollViewer>
</Window>
