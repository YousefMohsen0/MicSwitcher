<ui:FluentWindow x:Class="MicSwitcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:MicSwitcher.App"
        Title="MicSwitcher" Width="700" Height="880" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        Icon="pack://application:,,,/Assets/app.ico">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="MicSwitcher">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" Width="16" Height="16"/>
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,8,24,28" MaxWidth="760">

        <!-- Status -->
        <ui:Card Margin="0,0,0,14" Padding="22">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
              <TextBlock Text="ACTIVE MICROPHONE" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Ellipse x:Name="StatusDot" Width="14" Height="14" Fill="Gray" VerticalAlignment="Center" Margin="0,3,12,0"/>
                <TextBlock x:Name="ActiveText" FontSize="28" FontWeight="SemiBold" Text="Starting…"/>
              </StackPanel>
              <TextBlock x:Name="DetailText" Margin="0,6,0,0" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <ui:ToggleSwitch x:Name="PauseCheck" Grid.Column="1" VerticalAlignment="Top" Margin="16,0,0,0"
                             Content="Pause switching"
                             Checked="PauseCheck_Changed" Unchecked="PauseCheck_Changed"/>
          </Grid>
        </ui:Card>

        <!-- Microphones -->
        <TextBlock Text="Microphones" FontSize="18" FontWeight="SemiBold" Margin="2,6,0,10"/>

        <ui:Card Margin="0,0,0,10" Padding="20">
          <local:MicRow x:Name="ProRow"/>
        </ui:Card>
        <ui:Card Margin="0,0,0,10" Padding="20">
          <local:MicRow x:Name="HeadsetRow"/>
        </ui:Card>
        <ui:Card Margin="0,0,0,18" Padding="20">
          <local:MicRow x:Name="LaptopRow"/>
        </ui:Card>

        <!-- Calibration -->
        <TextBlock Text="Calibration" FontSize="18" FontWeight="SemiBold" Margin="2,0,0,10"/>
        <ui:Card Margin="0,0,0,18" Padding="22">
          <StackPanel>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="A guided test of about 15 seconds. It measures your room noise and how loud you are on each mic, and sets both voice thresholds. Wear your headset while testing so MicSwitcher can learn to tell the two mics apart."/>

            <ui:ToggleSwitch x:Name="AdjustGainCheck" Margin="0,16,0,0"
                             Content="Also adjust the pro mic's Windows input volume"
                             Checked="AdjustGainCheck_Changed" Unchecked="AdjustGainCheck_Changed"/>

            <ui:Button x:Name="CalibrateButton" Margin="0,16,0,0" Appearance="Primary"
                       Content="Start calibration" Click="CalibrateButton_Click"/>

            <Border x:Name="CalibrationPanel" Visibility="Collapsed" Margin="0,18,0,0" Padding="20" CornerRadius="8"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
              <StackPanel>
                <TextBlock x:Name="CalibrationStepText" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="CalibrationTitleText" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="CalibrationHintText" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="CountdownText" FontSize="64" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <ProgressBar x:Name="CalibrationProgress" Minimum="0" Maximum="1" Height="6" Margin="0,10,0,0"/>
                <ui:Button x:Name="CancelCalibrationButton" Content="Cancel" HorizontalAlignment="Right" Margin="0,14,0,0"
                           Click="CancelCalibrationButton_Click"/>
              </StackPanel>
            </Border>

            <TextBlock x:Name="CalibrationText" Margin="0,14,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </ui:Card>

        <!-- Fine tuning -->
        <TextBlock Text="Fine tuning" FontSize="18" FontWeight="SemiBold" Margin="2,0,0,10"/>
        <ui:Card Margin="0,0,0,18" Padding="22">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="230"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Pro mic voice threshold" VerticalAlignment="Center"/>
            <Slider x:Name="ThresholdSlider" Grid.Column="1" Minimum="-80" Maximum="-10" Margin="8,8"
                    ValueChanged="ThresholdSlider_ValueChanged"/>
            <TextBlock x:Name="ThresholdValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="1" Text="Headset mic voice threshold" VerticalAlignment="Center"/>
            <Slider x:Name="HeadsetThresholdSlider" Grid.Row="1" Grid.Column="1" Minimum="-80" Maximum="-10" Margin="8,8"
                    ValueChanged="HeadsetThresholdSlider_ValueChanged"/>
            <TextBlock x:Name="HeadsetThresholdValue" Grid.Row="1" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="2" Text="Pro mic quiet for (before the headset can take over)" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <Slider x:Name="SilenceSlider" Grid.Row="2" Grid.Column="1" Minimum="0.5" Maximum="15" Margin="8,8"
                    ValueChanged="SilenceSlider_ValueChanged"/>
            <TextBlock x:Name="SilenceValue" Grid.Row="2" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="3" Text="Voice needed before switching" VerticalAlignment="Center"/>
            <Slider x:Name="ReturnSlider" Grid.Row="3" Grid.Column="1" Minimum="100" Maximum="1500" Margin="8,8"
                    ValueChanged="ReturnSlider_ValueChanged"/>
            <TextBlock x:Name="ReturnValue" Grid.Row="3" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
        </ui:Card>

        <!-- Behaviour -->
        <TextBlock Text="Appearance" FontSize="18" FontWeight="SemiBold" Margin="2,0,0,10"/>
        <ui:Card Margin="0,0,0,18" Padding="22">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Theme" VerticalAlignment="Center"/>
            <ComboBox x:Name="ThemeCombo" Grid.Column="1" SelectionChanged="ThemeCombo_SelectionChanged">
              <ComboBoxItem Content="Follow Windows" Tag="System"/>
              <ComboBoxItem Content="Light" Tag="Light"/>
              <ComboBoxItem Content="Dark" Tag="Dark"/>
              <ComboBoxItem Content="Black (OLED)" Tag="Black"/>
            </ComboBox>
          </Grid>
        </ui:Card>

        <TextBlock Text="Bleed protection" FontSize="18" FontWeight="SemiBold" Margin="2,0,0,10"/>
        <ui:Card Margin="0,0,0,18" Padding="22">
          <StackPanel>
            <ui:ToggleSwitch x:Name="BleedCheck"
                             Content="Ignore sound that comes out of my speakers or headphones"
                             Checked="BleedCheck_Changed" Unchecked="BleedCheck_Changed"/>
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Discord callers or music leaking into a mic will not count as you talking. The app listens to what is being played and raises the voice threshold by the amount that normally leaks into each mic. Re-run a calibration with the usual playback going to tune it."/>
            <TextBlock x:Name="BleedStatus" Margin="0,8,0,0" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
          </StackPanel>
        </ui:Card>

        <TextBlock Text="Updates" FontSize="18" FontWeight="SemiBold" Margin="2,0,0,10"/>
        <ui:Card Margin="0,0,0,18" Padding="22">
          <StackPanel>
            <ui:ToggleSwitch x:Name="AutoCheckCheck" Content="Check for updates automatically"
                             Checked="Updates_Changed" Unchecked="Updates_Changed"/>
            <ui:ToggleSwitch x:Name="AutoInstallCheck" Margin="0,12,0,0" Content="Install updates automatically"
                             Checked="Updates_Changed" Unchecked="Updates_Changed"/>
            <ui:ToggleSwitch x:Name="PrereleaseCheck" Margin="0,12,0,0" Content="Include early (pre-release) versions"
                             Checked="Updates_Changed" Unchecked="Updates_Changed"/>
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <ui:Button x:Name="UpdateButton" Content="Check for updates" Click="UpdateButton_Click"/>
              <TextBlock x:Name="UpdateInfoText" Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
          </StackPanel>
        </ui:Card>

        <TextBlock Text="Behaviour" FontSize="18" FontWeight="SemiBold" Margin="2,0,0,10"/>
        <ui:Card Margin="0,0,0,18" Padding="22">
          <StackPanel>
            <ui:ToggleSwitch x:Name="CommsCheck"
                             Content="Also change the default communications device (Teams, Discord, Zoom…)"
                             Checked="CommsCheck_Changed" Unchecked="CommsCheck_Changed"/>
            <ui:ToggleSwitch x:Name="StartupCheck" Margin="0,14,0,0"
                             Content="Start with Windows (background, administrator rights)"
                             Checked="StartupCheck_Changed" Unchecked="StartupCheck_Changed"/>
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Turning startup on or off asks for administrator permission once. Closing this window keeps MicSwitcher running in the system tray; use the tray menu to exit."/>
          </StackPanel>
        </ui:Card>

        <!-- Log -->
        <Expander Header="Activity log" Margin="0,0,0,0" HorizontalAlignment="Stretch">
          <ListBox x:Name="LogList" Height="170" FontFamily="Consolas" FontSize="12" Margin="0,8,0,0"/>
        </Expander>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</ui:FluentWindow>
