<UserControl x:Class="MicSwitcher.App.MicRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:MicSwitcher.App">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <ui:SymbolIcon x:Name="RoleIcon" Symbol="Mic24" FontSize="26" Margin="0,2,16,0" VerticalAlignment="Top"/>

    <StackPanel Grid.Column="1">
      <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"/>
      <TextBlock x:Name="SubtitleText" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
    </StackPanel>

    <Image x:Name="RoleImage" Width="26" Height="26" Margin="0,2,16,0" VerticalAlignment="Top"
           HorizontalAlignment="Left" Visibility="Collapsed"/>

    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
      <TextBlock x:Name="BadgeText" VerticalAlignment="Center" FontWeight="SemiBold"/>
      <ui:Button x:Name="UpButton" Icon="{ui:SymbolIcon ChevronUp24}" Appearance="Transparent" Padding="6"
                 Margin="8,-4,0,-4" ToolTip="{local:T Row_MoveUp}" Click="UpButton_Click"/>
      <ui:Button x:Name="DownButton" Icon="{ui:SymbolIcon ChevronDown24}" Appearance="Transparent" Padding="6"
                 Margin="0,-4,0,-4" ToolTip="{local:T Row_MoveDown}" Click="DownButton_Click"/>
      <ui:Button x:Name="EditButton" Icon="{ui:SymbolIcon Edit24}" Appearance="Transparent" Padding="6"
                 Margin="0,-4,0,-4" ToolTip="{local:T Row_Edit}" Click="EditButton_Click"/>
      <ui:Button x:Name="RemoveButton" Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent" Padding="6"
                 Margin="0,-4,-6,-4" ToolTip="{local:T Row_Remove}" Click="RemoveButton_Click"/>
    </StackPanel>

    <ComboBox x:Name="DeviceCombo" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
              HorizontalAlignment="Stretch" Margin="0,14,0,0" DisplayMemberPath="Name"/>

    <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <Grid x:Name="MeterHost" Height="16" VerticalAlignment="Center" SizeChanged="MeterHost_SizeChanged">
        <ProgressBar x:Name="Meter" Minimum="-80" Maximum="0" Value="-80" Height="6" VerticalAlignment="Center"/>
        <Rectangle x:Name="ThresholdMarker" Width="2" Height="16" HorizontalAlignment="Left"
                   Fill="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.75"
                   Visibility="Collapsed" ToolTip="Voice threshold: levels above this line count as a voice"/>
      </Grid>

      <TextBlock x:Name="LevelText" Grid.Column="1" MinWidth="58" Margin="12,0,0,0" TextAlignment="Right"
                 VerticalAlignment="Center" Text="—" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
    </Grid>

    <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="{local:T Row_Threshold}" VerticalAlignment="Center" Margin="0,0,12,0"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
      <Slider x:Name="ThresholdSlider" Grid.Column="1" Minimum="-80" Maximum="-10" TickFrequency="1"
              IsSnapToTickEnabled="True" ValueChanged="ThresholdSlider_ValueChanged"/>
      <TextBlock x:Name="ThresholdText" Grid.Column="2" MinWidth="58" Margin="12,0,0,0" TextAlignment="Right"
                 VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
    </Grid>
  </Grid>
</UserControl>
