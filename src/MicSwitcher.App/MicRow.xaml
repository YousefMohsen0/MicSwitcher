<UserControl x:Class="MicSwitcher.App.MicRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="0,8,0,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="14"/>
    <TextBlock x:Name="BadgeText" Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#666"/>

    <ComboBox x:Name="DeviceCombo" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,6" DisplayMemberPath="Name"/>

    <ProgressBar x:Name="Meter" Grid.Row="2" Height="8" Minimum="-80" Maximum="0" Value="-80" VerticalAlignment="Center"/>
    <TextBlock x:Name="LevelText" Grid.Row="2" Grid.Column="1" Margin="10,0,0,0" MinWidth="52"
               TextAlignment="Right" Foreground="#666" Text="—"/>
  </Grid>
</UserControl>
